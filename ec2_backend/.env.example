# EC2 Backend Environment Variables
# Copy this file to .env and fill in your real values.

# AWS region where your SNS topic lives
AWS_REGION=ap-south-1

# Full ARN of your SNS topic (leave empty to disable SNS during local testing)
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:SmartGateKioskAlerts

# Optional: EC2 instance will use the IAM role for boto3 credentials.
# For local testing without an IAM role, you can set explicit credentials:
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
